# Copy to .env (never commit .env) and fill in your own values. See bot/README.md.
TELEGRAM_BOT_TOKEN=paste-the-token-from-BotFather-here
DATABASE_URL=sqlite:///fbt_bot.db
# Alert when one transaction is larger than this (₸)
BIG_TX_THRESHOLD=50000
# Alert when a cash or bank card account falls below this (₸)
LOW_BALANCE_THRESHOLD=10000
# How often the bot checks for new alerts (seconds)
CHECK_INTERVAL_SECONDS=60
